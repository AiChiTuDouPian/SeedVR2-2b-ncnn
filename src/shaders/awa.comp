#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
// AWA (Adaptive Window Attention) — 两遍 softmax 版
// partition -> qk_norm -> mmrope3d(RoPE) -> varlen SDPA(两遍 softmax, 与 CPU awa_forward 一致) -> reverse
// 每个 workgroup 处理一个 (window, head)；query 块(128) 内线程逐 query 两遍遍历全部 key。
//
// 绑定顺序 = record_pipeline 的 bindings[0..11]；参数走 push_constant(parameter)。
// dispatcher：w=1, h=HEADS, c=nwin（每个 workgroup 一个 window+head）。

layout(push_constant) uniform parameter
{
    int DIM;
    int HEAD_D;
    int HEADS;
    int ROPE_ROT;
    int nwin;
    int TXT;
    int Lv;
    int sumf;
    float SCALE;   // 1/sqrt(HEAD_D)
    float EPS;
} p;

layout(binding = 0)  readonly buffer b_vqkv { float vqkv[]; };   // Lv * 3*DIM
layout(binding = 1)  readonly buffer b_tqkv { float tqkv[]; };   // TXT * 3*DIM
layout(binding = 2)  readonly buffer b_vidx { float vidx[]; };   // sumf
layout(binding = 3)  readonly buffer b_cumf { float cumf[]; };   // nwin+1
layout(binding = 4)  readonly buffer b_vfreq { float vfreq[]; }; // sumf * ROPE_ROT
layout(binding = 5)  readonly buffer b_tfreq { float tfreq[]; }; // nwin*TXT * ROPE_ROT
layout(binding = 6)  readonly buffer b_nqv { float nqv[]; };     // HEAD_D
layout(binding = 7)  readonly buffer b_nkv { float nkv[]; };     // HEAD_D
layout(binding = 8)  readonly buffer b_nqt { float nqt[]; };     // HEAD_D
layout(binding = 9)  readonly buffer b_nkt { float nkt[]; };     // HEAD_D
layout(binding = 10) writeonly buffer b_vattn { float vattn[]; };// Lv * DIM
layout(binding = 11) writeonly buffer b_toutw { float toutw[]; };// nwin*TXT * DIM

#define HD 128

// qk_norm + RoPE 一个 token（vid 或 txt），写入 out
void prep_token(int tok, int is_vid, int fbase, int is_q,
                const int base, const int QKV,
                out float outq[HD])
{
    int d;
    for (d = 0; d < HD; d++) {
        if (is_vid != 0) {
            outq[d] = is_q != 0 ? vqkv[tok * QKV + 0 * p.DIM + base + d]
                                : vqkv[tok * QKV + 1 * p.DIM + base + d];
        } else {
            outq[d] = is_q != 0 ? tqkv[tok * QKV + 0 * p.DIM + base + d]
                                : tqkv[tok * QKV + 1 * p.DIM + base + d];
        }
    }
    float sq = 0.0;
    for (d = 0; d < HD; d++) sq += outq[d] * outq[d];
    float r = sqrt(sq / float(HD) + p.EPS);
    for (d = 0; d < HD; d++) {
        float w = is_vid != 0 ? (is_q != 0 ? nqv[d] : nkv[d])
                              : (is_q != 0 ? nqt[d] : nkt[d]);
        outq[d] = outq[d] / r * w;
    }
    for (int k = 0; k < p.ROPE_ROT; k += 2) {
        float fr = (is_vid != 0 ? vfreq[fbase + k] : tfreq[fbase + k]);
        float c = cos(fr), s = sin(fr);
        float a = outq[k], b = outq[k + 1];
        outq[k]     = a * c - b * s;
        outq[k + 1] = b * c + a * s;
    }
}

// v token 读取（无 norm/rope）
void get_v(int tok, int is_vid, const int base, const int QKV, out float vv[HD])
{
    for (int d = 0; d < HD; d++)
        vv[d] = is_vid != 0 ? vqkv[tok * QKV + 2 * p.DIM + base + d]
                            : tqkv[tok * QKV + 2 * p.DIM + base + d];
}

void main()
{
    int wi = int(gl_WorkGroupID.z);
    int h  = int(gl_WorkGroupID.y);
    if (wi >= p.nwin || h >= p.HEADS) return;

    int DIM  = p.DIM;
    int QKV  = DIM * 3;
    int base = h * HD;
    int f_i  = int(cumf[wi + 1] + 0.5) - int(cumf[wi] + 0.5);
    int S    = f_i + p.TXT;
    int tid  = int(gl_LocalInvocationID.x);

    for (int qb = 0; qb < S; qb += 128)
    {
        int a = qb + tid;
        if (a >= S) break;   // 本 workgroup 只处理 query 块首 128；S<=128 时每个线程一个 query

        int g = 0, q_tok = 0, q_fbase = 0;
        int q_is_vid = (a < f_i) ? 1 : 0;
        if (q_is_vid != 0) {
            g = int(cumf[wi] + 0.5) + a;
            q_tok = int(vidx[g] + 0.5);
            q_fbase = g * p.ROPE_ROT;
        } else {
            int ii = a - f_i;
            q_tok = ii;
            q_fbase = (wi * p.TXT + ii) * p.ROPE_ROT;
        }
        float qq[HD];
        prep_token(q_tok, q_is_vid, q_fbase, 1, base, QKV, qq);

        // 两遍 softmax：第一遍求全局 max
        float mx = -1e30f;
        for (int b = 0; b < S; b++) {
            int b_is_vid = (b < f_i) ? 1 : 0;
            int k_tok, k_fbase;
            if (b_is_vid != 0) {
                int g2 = int(cumf[wi] + 0.5) + b;
                k_tok = int(vidx[g2] + 0.5);
                k_fbase = g2 * p.ROPE_ROT;
            } else {
                int ii = b - f_i;
                k_tok = ii;
                k_fbase = (wi * p.TXT + ii) * p.ROPE_ROT;
            }
            float kk[HD];
            prep_token(k_tok, b_is_vid, k_fbase, 0, base, QKV, kk);
            float dot = 0.0;
            for (int d = 0; d < HD; d++) dot += qq[d] * kk[d];
            dot *= p.SCALE;
            if (dot > mx) mx = dot;
        }

        // 第二遍：累积 exp * v
        float sum = 0.0;
        float outv[HD];
        for (int d = 0; d < HD; d++) outv[d] = 0.0;
        for (int b = 0; b < S; b++) {
            int b_is_vid = (b < f_i) ? 1 : 0;
            int k_tok, k_fbase;
            if (b_is_vid != 0) {
                int g2 = int(cumf[wi] + 0.5) + b;
                k_tok = int(vidx[g2] + 0.5);
                k_fbase = g2 * p.ROPE_ROT;
            } else {
                int ii = b - f_i;
                k_tok = ii;
                k_fbase = (wi * p.TXT + ii) * p.ROPE_ROT;
            }
            float kk[HD];
            prep_token(k_tok, b_is_vid, k_fbase, 0, base, QKV, kk);
            float vv[HD];
            get_v(k_tok, b_is_vid, base, QKV, vv);
            float dot = 0.0;
            for (int d = 0; d < HD; d++) dot += qq[d] * kk[d];
            dot *= p.SCALE;
            float pr = exp(dot - mx);
            sum += pr;
            for (int d = 0; d < HD; d++) outv[d] += pr * vv[d];
        }

        for (int d = 0; d < HD; d++) outv[d] /= sum;
        if (q_is_vid != 0) {
            g = int(cumf[wi] + 0.5) + a;
            int tok = int(vidx[g] + 0.5);
            for (int d = 0; d < HD; d++) vattn[tok * DIM + base + d] = outv[d];
        } else {
            int ii = a - f_i;
            int off = (wi * p.TXT + ii) * DIM + base;
            for (int d = 0; d < HD; d++) toutw[off + d] = outv[d];
        }
    }
}
