#version 450

// AWA 输入复制：把 fp32 输入 vqkv 复制到独立 buffer，避免 ncnn 图内 blob 复用覆盖输入。
// 用法：dispatcher.w = 元素数，local_size 128
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) buffer b_in { float i[]; };
layout(binding = 1) buffer b_out { float o[]; };

layout(push_constant) uniform parameter
{
    int total;
} p;

void main()
{
    int gid = int(gl_GlobalInvocationID.x);
    if (gid < p.total)
        o[gid] = i[gid];
}
