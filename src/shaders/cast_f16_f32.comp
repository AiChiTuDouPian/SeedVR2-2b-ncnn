#version 450

// fp16 -> fp32（flat 线性布局；fp16 2 字节/元素，按 uint 打包读：每 uint 含 2 个 half）
// 与 cast_bf16_f32 的区别：bf16->fp32 是纯位对齐 (u<<16)，fp16 需要指数/尾数重排，
// 直接用 GLSL 内置 unpackHalf2x16（Vulkan GLSL 4.2+ 内置，含次正规数/NaN 处理）。
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer b_in  { uint inb[]; };
layout(binding = 1) writeonly buffer b_out { float o[]; };

layout(push_constant) uniform parameter
{
    int total;
} p;

void main()
{
    int gid = int(gl_GlobalInvocationID.x);
    if (gid >= p.total) return;
    uint u = (gid & 1) == 1 ? (inb[gid >> 1] >> 16) : (inb[gid >> 1] & 0xFFFFu);
    o[gid] = unpackHalf2x16(u).x;   // unpack 的 x = 低 16 位 half；u 已把目标 half 挪到低 16 位
}
